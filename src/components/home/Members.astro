---
import Translations from "@assets/json/translations.json"

const locale = Astro.currentLocale ?? "fr"
const translation = Translations[locale as keyof typeof Translations].association
---

<article class="content">
    <h2>{translation.headOffice}</h2>
    <section>
        <div>
            <p>{translation.president}</p>
            <p>Maxime <span>Myself Fake</span> MOIROUD</p>
        </div>
        <div>
            <p>{translation.vicePresident}</p>
            <p>Louis <span>Canard.exe</span> GRILLOT</p>
        </div>
        <div>
            <p>{translation.secretary}</p>
            <p>Alexis <span>Myself Real</span> LOCATELLI</p>
        </div>
    </section>
</article>

<style lang="scss">
    section {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-evenly;
        gap: 2rem;

        div {
            flex: 1 1 calc(100% / 3 - 1.334rem);
            text-align: center;

            p:first-of-type {
                font-weight: bold;
                font-size: 1.25em;
                color: var(--special-color);
                margin-bottom: 6px;
            }

            span {
                font-weight: bold;

                &:before {
                    content: "“";
                }

                &:after {
                    content: "”";
                }
            }

            @media (max-width: 900px) {
                flex-basis: calc(100% / 2 - 1rem);
            }

            @media (max-width: 560px) {
                flex-basis: 100%;
            }
        }
    }
</style>
