---
import { Image } from "astro:assets"
import Layout from "@layouts/Layout.astro"
import Banner from "@components/Banner.astro"
import Table from "@components/Table.astro"
import Translations from "@assets/json/translations.json"
import CEC_Banner from "@assets/img/carousel/cec/3.webp"
import BoulangeriePatisserieModelon from "@assets/img/sponsors/boulangerie-patisserie-modelon.webp"
import DroneProcess from "@assets/img/sponsors/drone-process.webp"
import Ecoprestige from "@assets/img/sponsors/ecoprestige.webp"
import SaintLaurentDuPont from "@assets/img/sponsors/saint-laurent-du-pont.webp"
import CoeurChartreuse from "@assets/img/sponsors/coeur-de-chartreuse.webp"
import LOL_Logo from "@assets/img/games/logo/league-of-legends.webp"
import LOL_Banner from "@assets/img/games/banner/league-of-legends.webp"
import LOL_Ranking from "@assets/json/cec/3/league-of-legends.json"
import RL_Logo from "@assets/img/games/logo/rocket-league.webp"
import RL_Banner from "@assets/img/games/banner/rocket-league.webp"
import RL_Ranking from "@assets/json/cec/3/rocket-league.json"
import type { GameInterface } from "@types"

const locale = Astro.currentLocale ?? "fr"
const translation = Translations[locale as keyof typeof Translations]
const lol: GameInterface = {
    name: "League of Legends",
    logo: LOL_Logo,
    banner: LOL_Banner
}
const rl: GameInterface = {
    name: "Rocket League",
    logo: RL_Logo,
    banner: RL_Banner
}
---

<Layout title={translation.tournaments.CEC[3]!.name}>
    <Banner title={translation.tournaments.CEC[3]!.name} image={CEC_Banner} />

    <div class="banner-content">
        <article id="sponsors" class="content">
            <Image src={BoulangeriePatisserieModelon} alt="Boulangerie Pâtisserie Modelon" />
            <Image src={DroneProcess} alt="Drone Process" />
            <Image src={Ecoprestige} alt="Ecoprestige" />
            <Image src={SaintLaurentDuPont} alt="Saint Laurent du Pont" />
            <Image src={CoeurChartreuse} alt="Coeur de Chartreuse" />
        </article>

        <article id="presentation" class="content">
            <h2>{translation.presentation}</h2>
            <p>{translation.tournaments.CEC[3]!.presentation}</p>
        </article>

        <Table game={lol} data={LOL_Ranking} />
        <Table game={rl} data={RL_Ranking} />
    </div>
</Layout>
