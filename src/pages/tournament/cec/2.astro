---
import { Image } from "astro:assets"
import Layout from "@layouts/Layout.astro"
import Banner from "@components/Banner.astro"
import Table from "@components/Table.astro"
import Translations from "@assets/json/translations.json"
import CEC_Banner from "@assets/img/carousel/cec/2.webp"
import CoeurChartreuse from "@assets/img/sponsors/coeur-de-chartreuse.webp"
import LDLC from "@assets/img/sponsors/ldlc.webp"
import GCInformatique from "@assets/img/sponsors/gc-informatique.webp"
import InovConcept from "@assets/img/sponsors/inov-concept.webp"
import LOL_Logo from "@assets/img/games/logo/league-of-legends.webp"
import LOL_Banner from "@assets/img/games/banner/league-of-legends.webp"
import LOL_Ranking from "@assets/json/cec/2/league-of-legends.json"
import type { GameInterface } from "@types"

const locale = Astro.currentLocale ?? "fr"
const translation = Translations[locale as keyof typeof Translations]
const lol: GameInterface = {
    name: "League of Legends",
    logo: LOL_Logo,
    banner: LOL_Banner
}
---

<Layout title={translation.tournaments.CEC[2]!.name}>
    <Banner title={translation.tournaments.CEC[2]!.name} image={CEC_Banner} />

    <div class="banner-content">
        <article id="sponsors" class="content">
            <Image src={CoeurChartreuse} alt="Coeur de Chartreuse" />
            <Image src={LDLC} alt="LDLC" />
            <Image src={GCInformatique} alt="GC Informatique" />
            <Image src={InovConcept} alt="Inov' Concept" />
        </article>

        <article id="presentation" class="content">
            <h2>{translation.presentation}</h2>
            <p>{translation.tournaments.CEC[2]!.presentation}</p>
        </article>

        <Table game={lol} data={LOL_Ranking} />
    </div>
</Layout>
