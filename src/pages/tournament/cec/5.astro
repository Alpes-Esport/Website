---
import { Image } from "astro:assets"
import Layout from "@layouts/Layout.astro"
import Banner from "@components/Banner.astro"
import Table from "@components/Table.astro"
import Translations from "@assets/json/translations.json"
import CEC_Banner from "@assets/img/carousel/cec/5.webp"
import FullLife from "@assets/img/sponsors/fulllife.webp"
import DroneProcess from "@assets/img/sponsors/drone-process.webp"
import Noctua from "@assets/img/sponsors/noctua.webp"
import CoeurChartreuse from "@assets/img/sponsors/coeur-de-chartreuse.webp"
import SaintLaurentDuPont from "@assets/img/sponsors/saint-laurent-du-pont.webp"
import RL_Logo from "@assets/img/games/logo/rocket-league.webp"
import RL_Banner from "@assets/img/games/banner/rocket-league.webp"
import RL_Ranking from "@assets/json/cec/5/rocket-league.json"
import CS_Logo from "@assets/img/games/logo/counter-strike.webp"
import CS_Banner from "@assets/img/games/banner/counter-strike.webp"
import CS_Ranking from "@assets/json/cec/5/counter-strike.json"
import LOL_Logo from "@assets/img/games/logo/league-of-legends.webp"
import LOL_Banner from "@assets/img/games/banner/league-of-legends.webp"
import LOL_Ranking from "@assets/json/cec/5/league-of-legends.json"
import type { GameInterface } from "@types"

const locale = Astro.currentLocale ?? "fr"
const translation = Translations[locale as keyof typeof Translations]
const rl: GameInterface = {
    name: "Rocket League",
    logo: RL_Logo,
    banner: RL_Banner
}
const csgo: GameInterface = {
    name: "Counter-Strike: Global Offensive",
    logo: CS_Logo,
    banner: CS_Banner
}
const lol: GameInterface = {
    name: "League of Legends",
    logo: LOL_Logo,
    banner: LOL_Banner
}
---

<Layout title={translation.tournaments.CEC[5]!.name}>
    <Banner title={translation.tournaments.CEC[5]!.name} image={CEC_Banner} />

    <div class="banner-content">
        <article id="sponsors" class="content">
            <Image src={FullLife} alt="FullLife" />
            <Image src={DroneProcess} alt="Drone Process" />
            <Image src={Noctua} alt="Noctua" />
            <Image src={CoeurChartreuse} alt="Coeur de Chartreuse" />
            <Image src={SaintLaurentDuPont} alt="Saint Laurent du Pont" />
        </article>

        <article id="presentation" class="content">
            <h2>{translation.presentation}</h2>
            <p>{translation.tournaments.CEC[5]!.presentation}</p>
        </article>

        <article id="ranking" class="content">
            <Table game={rl} data={RL_Ranking} />
            <Table game={csgo} data={CS_Ranking} />
        </article>
        <Table game={lol} data={LOL_Ranking} />
    </div>
</Layout>
