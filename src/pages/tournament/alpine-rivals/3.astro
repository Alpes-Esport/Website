---
import Layout from "@layouts/Layout.astro"
import Banner from "@components/Banner.astro"
import Cashprize from "@components/Cashprize.astro"
import Translations from "@assets/json/translations.json"
import AR_Banner from "@assets/img/carousel/alpine-rivals/3.webp"
import LOL_Logo from "@assets/img/games/logo/league-of-legends.webp"
import LOL_Banner from "@assets/img/games/banner/league-of-legends.webp"
import type { CashprizeInterface } from "@types"

const locale = Astro.currentLocale ?? "fr"
const translation = Translations[locale as keyof typeof Translations]
const cashprize: CashprizeInterface[] = [
    {
        game: {
            name: "League of Legends",
            logo: LOL_Logo,
            banner: LOL_Banner
        },
        cash: 300,
        regulation: "https://drive.google.com/file/d/1-trZDJ5B71FEh20Q0QNnw9dVhbl5VZ38/view"
    }
]
---

<Layout title={translation.tournaments.AlpineRivals[2]!.name}>
    <Banner title={translation.tournaments.AlpineRivals[2]!.name} image={AR_Banner} />

    <article id="presentation" class="content">
        <h2>{translation.presentation}</h2>
        <p>{translation.tournaments.AlpineRivals[2]!.presentation}</p>
    </article>

    <Cashprize title={true} data={cashprize} />
</Layout>

<style lang="scss">
    #ar-banner {
        height: 700px;

        &::after {
            // @include box-shadow(
            //     inset 0 100px 150px 0 var(--bg-color),
            //     inset 0 -100px 50px -30px var(--bg-color)
            // );
        }
    }
</style>
