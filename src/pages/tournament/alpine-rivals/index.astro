---
import Layout from "@layouts/Layout.astro"
import Banner from "@components/Banner.astro"
import Tournaments from "@components/Tournaments.astro"
import Translations from "@assets/json/translations.json"
import AR1_Thumbnail from "@assets/img/carousel/alpine-rivals/1.webp"
import AR2_Thumbnail from "@assets/img/carousel/alpine-rivals/2.webp"
import AR3_Thumbnail from "@assets/img/carousel/alpine-rivals/3.webp"
import type { TournamentsInterface } from "@types"

const locale = Astro.currentLocale ?? "fr"
const translation = Translations[locale as keyof typeof Translations]
const tournaments: TournamentsInterface = {
    title: translation.tournaments.editions,
    links: [
        {
            name: translation.tournaments.AlpineRivals[3]!.name,
            url: "/tournament/alpine-rivals/3",
            thumbnail: AR3_Thumbnail
        },
        {
            name: translation.tournaments.AlpineRivals[2]!.name,
            url: "/tournament/alpine-rivals/2",
            thumbnail: AR2_Thumbnail
        },
        {
            name: translation.tournaments.AlpineRivals[1]!.name,
            url: "/tournament/alpine-rivals/1",
            thumbnail: AR1_Thumbnail
        }
    ]
}
---

<Layout title={translation.tournaments.AlpineRivals[0]!.name}>
    <Banner title={translation.tournaments.AlpineRivals[0]!.name} image={AR3_Thumbnail} />

    <!-- <article id="presentation" class="content">
        <h2>{translation.presentation}</h2>
        <p>{translation.tournaments.AlpineRivals[0]!.presentation}</p>
    </article> -->

    <Tournaments data={tournaments} />
</Layout>

<style lang="scss">
    #presentation {
        padding: 0 0 1rem;
    }
</style>
